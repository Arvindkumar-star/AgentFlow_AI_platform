PORT=5000
NODE_ENV=development

# MongoDB — leave blank for in-memory fallback or provide URI
MONGODB_URI=mongodb://127.0.0.1:27017/agentflow

# JWT
JWT_SECRET=your_long_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Redis / BullMQ — leave blank for in-memory fallback
REDIS_URL=redis://127.0.0.1:6379

# Credential encryption key — must be 64 hex chars (32 bytes)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Providers
OPENROUTER_API_KEY=your_openrouter_or_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payouts (Test Sandbox)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_ACCOUNT_NUMBER=2323230041111111

# Google OAuth (Gmail + Sheets)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/gmail/callback
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/google-sheets/callback

# Slack
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/slack/callback

# Discord
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/discord/callback

# CORS
CLIENT_URL=http://localhost:3000
